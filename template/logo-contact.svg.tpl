<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 170" role="img" aria-label="{{name}} – {{languages}} {{role}}">
  <title>{{name}}</title>
  <circle cx="52" cy="52" r="44" fill="{{navy}}"/>
  <circle cx="52" cy="52" r="37" fill="none" stroke="{{gold}}" stroke-width="2.5"/>
  <text x="52" y="65" font-family="Georgia,serif" font-size="37" font-weight="700" fill="#fff" text-anchor="middle">{{initials}}</text>
  <text x="112" y="46" font-family="Georgia,serif" font-size="{{name_size_contact}}" font-weight="700" fill="{{navy}}">{{name}}</text>
  <line x1="114" y1="58" x2="390" y2="58" stroke="{{gold}}" stroke-width="2.5"/>
  <text x="114" y="80" font-family="system-ui,sans-serif" font-size="14" letter-spacing="2.5" fill="#5b6475">{{role_short}}</text>
  <text x="114" y="100" font-family="system-ui,sans-serif" font-size="14" letter-spacing="2.5" fill="#5b6475">{{languages_caps}}</text>
  <g font-family="system-ui,sans-serif" font-size="17" fill="{{navy}}">
    <text x="12" y="141" font-weight="700" fill="{{gold}}">T</text><text x="34" y="141">{{phone}}</text>
    <text x="12" y="165" font-weight="700" fill="{{gold}}">E</text><text x="34" y="165">{{email}}</text>
  </g>
</svg>
