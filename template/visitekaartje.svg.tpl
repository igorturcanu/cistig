<svg xmlns="http://www.w3.org/2000/svg" width="85mm" height="55mm" viewBox="0 0 850 550" role="img" aria-label="Visitekaartje {{name}}">
  <title>Visitekaartje {{name}}</title>
  <rect width="850" height="550" fill="#fff"/>
  <rect width="850" height="14" fill="#14304f"/>
  <circle cx="130" cy="150" r="80" fill="#14304f"/>
  <circle cx="130" cy="150" r="68" fill="none" stroke="#d9a441" stroke-width="4"/>
  <text x="130" y="174" font-family="Georgia,serif" font-size="68" font-weight="700" fill="#fff" text-anchor="middle">{{initials}}</text>
  <text x="250" y="140" font-family="Georgia,serif" font-size="{{name_size_card}}" font-weight="700" fill="#14304f">{{name}}</text>
  <line x1="254" y1="166" x2="780" y2="166" stroke="#d9a441" stroke-width="4"/>
  <text x="254" y="206" font-family="system-ui,sans-serif" font-size="28" letter-spacing="4" fill="#5b6475">{{role_short}}</text>
  <text x="254" y="244" font-family="system-ui,sans-serif" font-size="28" letter-spacing="4" fill="#5b6475">{{languages_caps}}</text>
  <g font-family="system-ui,sans-serif" font-size="34" fill="#14304f">
    <text x="70" y="380" font-weight="700" fill="#d9a441">T</text><text x="120" y="380">{{phone}}</text>
    <text x="70" y="440" font-weight="700" fill="#d9a441">E</text><text x="120" y="440">{{email}}</text>
  </g>
  <rect y="536" width="850" height="14" fill="#d9a441"/>
</svg>
